@model IEnumerable<ContractMonthlyClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Approved Claims";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Approved Claims - Ready for Payment</h4>
                    <a href="@Url.Action("GenerateReport", "HR", new { claimMonth = ViewBag.ClaimMonthFilter })" class="btn btn-success">Generate Report</a>
                </div>
                <div class="card-body">
                    <!-- Filter Section -->
                    <form method="get" action="@Url.Action("ApprovedClaims", "HR")" class="mb-3">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label for="claimMonth">Filter by Month</label>
                                    <select class="form-control" id="claimMonth" name="claimMonth" onchange="this.form.submit()">
                                        <option value="">All Months</option>
                                        @if (ViewBag.ClaimMonths != null)
                                        {
                                            foreach (var month in ViewBag.ClaimMonths)
                                            {
                                                <option value="@month" selected="@(month == ViewBag.ClaimMonthFilter)">@month</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Claim ID</th>
                                        <th>Lecturer</th>
                                        <th>Email</th>
                                        <th>Month</th>
                                        <th>Hours</th>
                                        <th>Rate</th>
                                        <th>Total Amount</th>
                                        <th>Submitted</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model)
                                    {
                                        <tr>
                                            <td>#@claim.ClaimId</td>
                                            <td>@claim.Lecturer.FirstName @claim.Lecturer.LastName</td>
                                            <td>@claim.Lecturer.Email</td>
                                            <td>@claim.ClaimMonth</td>
                                            <td>@claim.HoursWorked.ToString("F2")</td>
                                            <td>R @claim.HourlyRate.ToString("F2")</td>
                                            <td><strong>R @claim.TotalAmount?.ToString("F2")</strong></td>
                                            <td>@claim.SubmittedDate?.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-info">
                                        <td colspan="6" class="text-end"><strong>Total Amount Due:</strong></td>
                                        <td colspan="2"><strong>R @Model.Sum(c => c.TotalAmount).Value.ToString("F2")</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="mt-3">
                            <p class="text-muted">Total Claims: @Model.Count()</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">No approved claims found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
