@model ContractMonthlyClaimSystem.Models.User
@{
    ViewData["Title"] = "Edit Lecturer";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4>Edit Lecturer</h4>
                    <p class="mb-0 small text-muted">Lecturer ID: #@Model.UserId</p>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    <form method="post" action="@Url.Action("EditLecturer", "HR", new { id = Model.UserId })" id="editLecturerForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="firstName">First Name</label>
                                    <input type="text" class="form-control" id="firstName" name="firstName" value="@Model.FirstName" required maxlength="50">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="lastName">Last Name</label>
                                    <input type="text" class="form-control" id="lastName" name="lastName" value="@Model.LastName" required maxlength="50">
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label for="email">Email Address</label>
                            <input type="email" class="form-control" id="email" name="email" value="@Model.Email" required maxlength="100">
                            <small class="form-text text-muted">Changing email will update the login credentials</small>
                        </div>

                        <div class="form-group mb-3">
                            <label for="hourlyRate">Hourly Rate (R)</label>
                            <input type="number" step="0.01" min="0.01" max="9999.99" class="form-control" id="hourlyRate" name="hourlyRate" value="@(Model.HourlyRate?.ToString("F2") ?? "0.00")" required>
                            <small class="form-text text-muted">Rate must be between R0.01 and R9999.99</small>
                        </div>

                        <div class="alert alert-info">
                            <strong>Note:</strong> Password cannot be changed here. If password reset is needed, please delete and recreate the user.
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("ManageLecturers", "HR")" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('editLecturerForm').addEventListener('submit', function (e) {
        const submitBtn = document.getElementById('submitBtn');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';
    });
</script>
