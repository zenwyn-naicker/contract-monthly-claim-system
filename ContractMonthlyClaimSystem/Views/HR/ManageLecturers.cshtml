@model IEnumerable<ContractMonthlyClaimSystem.Models.User>
@{
    ViewData["Title"] = "Manage Lecturers";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>Manage Lecturers</h4>
                    <a href="@Url.Action("CreateLecturer", "HR")" class="btn btn-primary">Create New Lecturer</a>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Lecturer ID</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Hourly Rate</th>
                                        <th>Created Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lecturer in Model)
                                    {
                                        <tr>
                                            <td>#@lecturer.UserId</td>
                                            <td>@lecturer.FirstName @lecturer.LastName</td>
                                            <td>@lecturer.Email</td>
                                            <td>
                                                @if (lecturer.HourlyRate.HasValue)
                                                {
                                                    <strong>R @lecturer.HourlyRate.Value.ToString("F2")</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </td>
                                            <td>@lecturer.CreatedDate?.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <a href="@Url.Action("EditLecturer", "HR", new { id = lecturer.UserId })" class="btn btn-sm btn-outline-primary">Edit</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <p class="text-muted">Total Lecturers: @Model.Count()</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">No lecturers found.</p>
                            <a href="@Url.Action("CreateLecturer", "HR")" class="btn btn-primary">Create First Lecturer</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
